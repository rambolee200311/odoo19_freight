<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="freight_statement_wizard_form_view" model="ir.ui.view">
            <field name="name">freight.statement.wizard.form.view</field>
            <field name="model">freight.statement.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Settlement Statement">
                    <group>
                        <group>
                            <field name="shipment_id" string="Freight Operation"
                                   required="1" readonly="1"/>
                        </group>
                        <group>
                            <field name="customer_id" string="Customer"
                                   options="{'no_create': True}"
                                   domain="customer_domain"/>
                        </group>
                    </group>
                    <group>
                        <field name="customer_domain" invisible="1"/>
                        <field name="eligible_service_domain" invisible="1"/>
                        <field name="selected_service_ids" string="Selected Fees"
                               widget="many2many_checkboxes"
                               domain="eligible_service_domain"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <footer>
                        <button name="action_generate_statement" type="object"
                                string="Generate Statement" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="freight_statement_wizard_action" model="ir.actions.act_window">
            <field name="name">Generate Settlement Statement</field>
            <field name="res_model">freight.statement.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
