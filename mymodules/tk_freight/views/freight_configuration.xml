<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--res.partner-->
        <record id="res_partner_form_inherit_view" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.view</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook/page[@name='internal_notes']" position="after">
                    <page string="Multiple Invoice">
                        <field name="multiple_invoice_ids" readonly="1" string="Multiple Invoices">
                            <list>
                                <field name="date" string="Date"/>
                                <field name="amount" string="Amount"/>
                                <field name="invoice_id" widget="many2one_button" options="{'no_create':True}" string="Invoice"/>
                            </list>
                        </field>
                    </page>
                    <page string="Roles" name="roles">
                        <group>
                            <group>
                                <field name="shipper" invisible="0" string="Shipper"/>
                                <field name="consignee" invisible="0" string="Consignee"/>
                                <field name="agent" invisible="0" string="Agent"/>
                            </group>
                            <group>
                                <field name="vendor" invisible="0" string="Vendor"/>
                                <field name="notify" invisible="0" string="Notify Party"/>
                                <field name="is_policy" invisible="0" string="Policy Company"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <record id="consignee_partner_action" model="ir.actions.act_window">
            <field name="name">Consignee</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('consignee','=',True)]</field>
            <field name="context">{'default_consignee':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>
        <record id="shipper_partner_action" model="ir.actions.act_window">
            <field name="name">Shipper</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('shipper','=',True)]</field>
            <field name="context">{'default_shipper':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>
        <record id="vendor_partner_action" model="ir.actions.act_window">
            <field name="name">Vendor</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('vendor','=',True)]</field>
            <field name="context">{'default_vendor':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>
        <record id="agent_partner_action" model="ir.actions.act_window">
            <field name="name">Agent</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('agent','=',True)]</field>
            <field name="context">{'default_agent':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>
        <record id="policy_company_action" model="ir.actions.act_window">
            <field name="name">Policy Companies</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('is_policy','=',True)]</field>
            <field name="context">{'default_is_policy':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>
        <record id="notify_partner_action" model="ir.actions.act_window">
            <field name="name">Notify Party</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="domain">[('notify','=',True)]</field>
            <field name="context">{'default_notify':True}</field>
            <field name="view_mode">kanban,list,form,activity</field>
        </record>


        <!--Sale Order-->
        <record id="freight_quotation_inherit" model="ir.ui.view">
            <field name="name">freight.quotation.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sale_order_template_id']" position="before">
                    <field name="freight_id" force_save="1" invisible="not freight_id"
                           readonly="1" options="{'no_create':True}" string="Freight Shipment"/>
                </xpath>
                <xpath expr="//page[@name='other_information']" position="after">
                    <page string="Shipment Details" invisible="not freight_id">
                        <group>
                            <group>
                                <field name="direction" string="Direction"/>
                                <field name="operation" string="Operation"/>
                            </group>
                            <group>
                                <field name="transport" string="Transport"/>
                                <field name="agent_id" options="{'no_create':True}" string="Agent"/>
                            </group>
                        </group>
                        <group string="Shipper / Consignee">
                            <group>
                                <field name="shipper_id" options="{'no_create':True}" string="Shipper"/>
                            </group>
                            <group>
                                <field name="consignee_id" options="{'no_create':True}" string="Consignee"/>
                            </group>
                        </group>
                        <group string="Location">
                            <group>
                                <field name="source_location_id" options="{'no_create':True}" string="Source Location"/>
                            </group>
                            <group>
                                <field name="destination_location_id" options="{'no_create':True}" string="Destination Location"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!--Vendor Bills-->
        <record id="freight_vendor_bill_form_inherit" model="ir.ui.view">
            <field name="name">freight.vendor.bill.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="freight_operation_id" force_save="1" readonly="1"
                           invisible="not freight_operation_id" string="Freight Shipment"/>
                    <field name="freight_statement_id" force_save="1" readonly="1"
                           invisible="not freight_statement_id" string="Freight Statement"/>
                </xpath>
                <xpath expr="//page[@name='other_info']" position="after">
                    <page string="Shipment Details" invisible="not freight_operation_id">
                        <group>
                            <group>
                                <field name="direction" string="Direction"/>
                                <field name="operation" string="Operation"/>
                            </group>
                            <group>
                                <field name="transport" string="Transport"/>
                                <field name="agent_id" options="{'no_create':True}" string="Agent"/>
                            </group>
                        </group>
                        <group string="Shipper / Consignee">
                            <group>
                                <field name="shipper_id" options="{'no_create':True}" string="Shipper"/>
                            </group>
                            <group>
                                <field name="consignee_id" options="{'no_create':True}" string="Consignee"/>
                            </group>
                        </group>
                        <group string="Location">
                            <group>
                                <field name="source_location_id" options="{'no_create':True}" string="Source Location"/>
                            </group>
                            <group>
                                <field name="destination_location_id" options="{'no_create':True}" string="Destination Location"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!--Product Tax Master Fields-->
        <record id="product_template_tax_fields_view_inherit" model="ir.ui.view">
            <field name="name">product.template.tax.fields.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="inside">
                    <group string="Tax Code">
                        <group>
                            <field name="tax_code" string="Tax Code"/>
                        </group>
                        <group>
                            <field name="tax_name" string="Tax Name"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!--Services-->
        <record id="service_product_action" model="ir.actions.act_window">
            <field name="name">Services</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('type', '=', 'service')]</field>
            <field name="context">{'search_default_filter_to_sell': 1,'default_type':'service'}</field>
        </record>

        

        <!--Vessel-->
        <record model="ir.ui.view" id="vessel_form_view">
            <field name="name">vessel.form.view</field>
            <field name="model">freight.vessel</field>
            <field name="arch" type="xml">
                <form string="Vessels">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                            <h3>
                                <span class="d-inline-block">
                                    <field name="active" string="Active"/>
                                    <label for="active" string="Active"/>
                                </span>
                            </h3>
                        </div>
                        <group string="Ship / Vessels Details">
                            <group>
                                <field name="code" required="1" string="Code"/>
                                <field name="owner_id" required="1" options="{'no_create':True}" string="Owner"/>
                                <field name="port_of_registry" string="Port of Registry"/>
                                <field name="global_zone" string="Global Zone"/>
                            </group>
                            <group>
                                <field name="imo_number" string="IMO Number"/>
                                <field name="capacity" string="Capacity"/>
                                <field name="country" required="1" string="Country"/>
                            </group>
                        </group>
                        <group string="Engine Details">
                            <group>
                                <field name="engine" string="Engine"/>
                                <field name="engine_power" string="Engine Power"/>
                            </group>
                            <group>
                                <field name="speed" string="Speed"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="vessel_tree_view">
            <field name="name">vessel.list.view</field>
            <field name="model">freight.vessel</field>
            <field name="arch" type="xml">
                <list string="Vessels">
                    <field name="code" string="Code"/>
                    <field name="name" string="Name"/>
                    <field name="country" string="Country"/>
                    <field name="global_zone" string="Global Zone"/>
                    <field name="active" string="Active"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="freight_vessel_action">
            <field name="name">Vessels</field>
            <field name="res_model">freight.vessel</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new vessel.
                </p>
            </field>
        </record>

        <!--incoterms-->
        <record model="ir.ui.view" id="incoterms_form_view">
            <field name="name">incoterms.form.view</field>
            <field name="model">freight.incoterms</field>
            <field name="arch" type="xml">
                <form string="Incoterms">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                            <h3>
                                <span class="d-inline-block">
                                    <field name="active" string="Active"/>
                                    <label for="active" string="Active"/>
                                </span>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="code" required="1" string="Code"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="incoterms_tree_view">
            <field name="name">incoterms.list.view</field>
            <field name="model">freight.incoterms</field>
            <field name="arch" type="xml">
                <list string="Incoterms">
                    <field name="code" string="Code"/>
                    <field name="name" string="Name"/>
                    <field name="active" string="Active"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="freight_incoterms_action">
            <field name="name">Incoterms</field>
            <field name="res_model">freight.incoterms</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new incoterm.
                </p>
            </field>
        </record>

        <!--Packages-->
        <record model="ir.ui.view" id="package_form_view">
            <field name="name">package.form.view</field>
            <field name="model">freight.package</field>
            <field name="arch" type="xml">
                <form string="Packages">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                            <h3>
                                <span class="d-inline-block">
                                    <field name="active" string="Active"/>
                                    <label for="active" string="Active"/>
                                </span>
                            </h3>
                        </div>
                        <span class="d-inline-block" style="margin-right:10px;">
                            <field name="air" string="Air"/>
                            <label for="air" string="Air"/>
                        </span>
                        <span class="d-inline-block" style="margin-right:10px;">
                            <field name="ocean" string="Ocean"/>
                            <label for="ocean" string="Ocean"/>
                        </span>
                        <span class="d-inline-block" style="margin-right:10px;">
                            <field name="land" string="Land"/>
                            <label for="land" string="Land"/>
                        </span>
                        <group>
                            <group string="Used For">
                                <field name="code" required="1" string="Code"/>
                                <field name="container" string="Container/Box"/>
                                <field name="item" string="Is Item"/>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="charge" string="Charges"/>
                            </group>
                            <group string="Measurement">
                                <field name="height" required="1" string="Height"/>
                                <field name="width" required="1" string="Width"/>
                                <field name="length" required="1" string="Length"/>
                                <field name="volume" required="1" string="Volume"/>
                                <field name="gross_weight" required="1" string="Gross Weight"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="package_tree_view">
            <field name="name">package.list.view</field>
            <field name="model">freight.package</field>
            <field name="arch" type="xml">
                <list string="Packages">
                    <field name="name" string="Name"/>
                    <field name="code" string="Code"/>
                    <field name="gross_weight" string="Gross Weight"/>
                    <field name="volume" string="Volume"/>
                </list>
            </field>
        </record>
        <record id="package_search_view" model="ir.ui.view">
            <field name="name">package.search.view</field>
            <field name="model">freight.package</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Name"/>
                    <field name="code" string="Code"/>
                    <field name="volume" string="Volume"/>
                    <field name="length" string="Length"/>
                    <separator/>
                    <filter string="Container" name="container" domain="[('container', '=', True)]"/>
                    <separator/>
                    <filter string="Item" name="item" domain="[('item', '=', True)]"/>
                    <separator/>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="freight_package_action">
            <field name="name">Packages</field>
            <field name="res_model">freight.package</field>
            <field name="view_mode">list,form,search</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new package.
                </p>
            </field>
        </record>

        <!--MoveType-->
        <record model="ir.ui.view" id="move_type_form_view">
            <field name="name">move.type.form.view</field>
            <field name="model">freight.move.type</field>
            <field name="arch" type="xml">
                <form string="Move Types">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                            <h3>
                                <span class="d-inline-block">
                                    <field name="active" string="Active"/>
                                    <label for="active" string="Active"/>
