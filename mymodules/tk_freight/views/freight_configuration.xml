                                    <field name="active" string="Active"/>
                                    <label for="active" string="Active"/>
                                </span>
                            </h3>
                        </div>
                        <group string="Airline Details">
                            <group>
                                <field name="code" required="1" string="Code"/>
                                <field name="icao" string="ICAO"/>
                                <field name="country" required="1" string="Country"/>
                            </group>
                            <group>
                                <field name="aircraft_type" string="Aircraft Type"/>
                                <field name="owner_id" required="1" options="{'no_create':True}" string="Owner"/>
