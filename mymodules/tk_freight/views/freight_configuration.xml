                </p>
            </field>
        </record>

        <!--DocumentType / certificate type-->
        <record model="ir.ui.view" id="document_type_form_view">
            <field name="name">certificate.type.form.view</field>
            <field name="model">certificate.type</field>
            <field name="arch" type="xml">
                <form string="Document Types">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="type" default_focus="1"
                                       placeholder="Type" required="1" string="Type"/>
                            </h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="document_type_tree_view">
            <field name="name">certificate.type.list.view</field>
            <field name="model">certificate.type</field>
            <field name="arch" type="xml">
                <list string="Document Types">
                    <field name="type" string="Type"/>
                </list>
            </field>
        </record>
        <record model="ir.actions.act_window" id="document_type_action">
            <field name="name">Document Types</field>
            <field name="res_model">certificate.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new document type.
                </p>
            </field>
        </record>


        <!--Airline-->
        <record model="ir.ui.view" id="airline_form_view">
            <field name="name">airline.form.view</field>
            <field name="model">freight.airline</field>
            <field name="arch" type="xml">
                <form string="Airline">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                            <h3>
