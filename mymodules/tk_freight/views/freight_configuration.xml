        <record model="ir.actions.act_window" id="freight_airline_action">
            <field name="name">Airlines</field>
            <field name="res_model">freight.airline</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new airline.
                </p>
            </field>
        </record>

        <!--Freight Services Charges-->
        <record model="ir.ui.view" id="freight_service_form_view">
            <field name="name">freight.service.form.view</field>
            <field name="model">freight.service</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Service For">
                            <group>
                                <field name="service_type" options="{'horizontal':True}"
                                       widget="radio" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Service Type"/>
                                <field name="invoiced" invisible="1"/>
                                <field name="vendor_invoiced" invisible="1"/>
                            </group>
                            <group>
                                <field name="status" widget="badge" decoration-success="status=='bill'"
                                       decoration-info="status=='invoice'"
                                       decoration-danger="status=='pending'" string="Status"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="shipper_id" invisible="service_type != 'shipper'"
                                       readonly="invoiced or vendor_invoiced" options="{'no_create':True}"
                                       force_save="1" string="Shipper"/>
                                <field name="consignee_id" invisible="service_type != 'consignee'"
                                       readonly="invoiced or vendor_invoiced" options="{'no_create': True}"
                                       force_save="1" string="Consignee"/>
                                <field name="vendor_id" invisible="service_type != 'vendor'"
                                       readonly="invoiced or vendor_invoiced" options="{'no_create': True}"
                                       force_save="1" string="Vendor"/>
                            </group>
                        </group>
                        <group string=" Service">
                            <group>
                                <field name="service_id" required="1" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Service"/>
                            </group>
                            <group>
                                <field name="name" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Description"/>
                            </group>
                        </group>
                        <group string="Charges">
                            <group>
                                <field name="qty" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Quantity"/>
                            </group>
                            <group>
                                <field name="currency_id" required="1" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Currency"/>
                                <field name="sale" readonly="invoiced or vendor_invoiced"
                                       force_save="1" string="Price"/>
                                <!--<field name="cost" string="Cost"/>-->
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="freight_service_tree_view">
            <field name="name">freight.service.list.view</field>
            <field name="model">freight.service</field>
            <field name="arch" type="xml">
                <list>
                    <field name="service_type" widget="badge"
                           decoration-warning="service_type=='shipper'"
                           decoration-success="service_type=='consignee'"
                           decoration-info="service_type=='vendor'" string="Service Type"/>
                    <field name="service_id" string="Service"/>
                    <field name="name" string="Description"/>
                    <field name="qty" string="Quantity"/>
                    <field name="sale" string="Price"/>
                    <field name="currency_id" string="Currency"/>
                    <field name="status" widget="badge"
                           decoration-success="status=='bill'"
                           decoration-info="status=='invoice'"
                           decoration-danger="status=='pending'" string="Status"/>
                </list>
            </field>
        </record>
        <record id="freight_service_search_view" model="ir.ui.view">
            <field name="name">freight.service.search.view</field>
            <field name="model">freight.service</field>
            <field name="arch" type="xml">
                <search string="Search Services">
                    <field name="currency_id" string="Currency"/>
                    <field name="service_id" string="Service"/>
                    <field name="status" string="Status"/>
                    <group>
                        <filter string="Currency" name="currency_id" context="{'group_by':'currency_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record model="ir.actions.act_window" id="freight_service_action">
            <field name="name">Service</field>
            <field name="res_model">freight.service</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new service.
                </p>
            </field>
        </record>


        <!--Document Details-->
        <record id="freight_document_tree_view" model="ir.ui.view">
            <field name="name">freight.document.list.view</field>
            <field name="model">freight.documents</field>
            <field name="arch" type="xml">
                <list string="Document" editable="bottom">
                    <field name="freight_id" string="Freight Shipment"/>
                    <field name="type_id" options="{'no_create': True}" string="Type"/>
                    <field name="document_date" string="Date"/>
                    <field name="file_name" column_invisible="1"/>
                    <field name="document" filename="file_name" widget="binary" string="Document"/>
                </list>
            </field>
        </record>

        <!--Policy Risk-->
        <record id="policy_risk_tree_view" model="ir.ui.view">
            <field name="name">policy.risk.list.view</field>
            <field name="model">policy.risk</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name" string="Title"/>
                    <field name="desc" string="Description"/>
                </list>
            </field>
        </record>
        <record id="policy_risk_action" model="ir.actions.act_window">
            <field name="name">Policy Risks</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">policy.risk</field>
            <field name="view_mode">list</field>
        </record>

        <!--Dashboard-->
        <record model="ir.ui.view" id="freight_view">
            <field name="name">Freight Dashboard</field>
            <field name="model">dashboard.details</field>
            <field name="arch" type="xml">
                <kanban>
                </kanban>
            </field>
        </record>
        <record model="ir.ui.view" id="freight_dashboard_view">
            <field name="name">Dashboard</field>
            <field name="model">dashboard.details</field>
            <field name="arch" type="xml">
                <kanban>
                </kanban>
            </field>
        </record>

        <!--Frequent Route-->
        <record model="ir.ui.view" id="frequent_route_form_view">
            <field name="name">frequent.route.form.view</field>
            <field name="model">freight.frequent.route</field>
            <field name="arch" type="xml">
                <form string="Routes">
                    <sheet>
                        <div class="oe_title mb24">
                            <h1>
                                <field class="text-break" name="name" default_focus="1"
                                       placeholder="Name" required="1" string="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="source_location_id" placeholder="Source Location" required="1"
                                       options="{'no_create': True}" string="Source Location"/>
                            </group>
                            <group>
                                <field name="destination_location_id" placeholder="Destination Location" required="1"
                                       options="{'no_create': True}" string="Destination Location"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="frequent_route_tree_view">
            <field name="name">frequent.route.list.view</field>
            <field name="model">freight.frequent.route</field>
            <field name="arch" type="xml">
                <list string="Route">
                    <field name="name" string="Name"/>
                    <field name="source_location_id" string="Source Location"/>
                    <field name="destination_location_id" string="Destination Location"/>
                </list>
            </field>
        </record>
        <record id="frequent_route_action" model="ir.actions.act_window">
            <field name="name">Frequent Route</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">freight.frequent.route</field>
            <field name="view_mode">list,form</field>
        </record>
        <!--Fleet-->
        <record id="shipment_fleet_inherit_form_view" model="ir.ui.view">
            <field name="name">shipment.fleet.inherit.form.view</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='active']" position="before">
                    <field name="is_freight_shipment" string="Is Freight Shipment"/>
                    <field name="owner_id" required="is_freight_shipment" options="{'no_create': True}" string="Owner"/>
                </xpath>
            </field>
        </record>
        <record id="shipmen_fleet_action" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="domain">[('is_freight_shipment', '=', True)]</field>
            <field name="context">{'default_is_freight_shipment': True}</field>
        </record>

        <!--Freight Tracking Location-->
        <record model="ir.ui.view" id="shipment_tracking_location_tree_view">
            <field name="name">shipment.tracking.location.list.view</field>
            <field name="model">shipment.location</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="name" required="1" string="Name"/>
                </list>
            </field>
        </record>
        <record id="shipment_tracking_location_action" model="ir.actions.act_window">
            <field name="name">Shipment Tracking Locations</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shipment.location</field>
            <field name="view_mode">list</field>
        </record>
        <!--Freight Tracking Activity-->
        <record model="ir.ui.view" id="shipment_tracking_activity_tree_view">
            <field name="name">shipment.tracking.location.activity.view</field>
            <field name="model">shipment.location.activity</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="name" required="1" string="Name"/>
                </list>
            </field>
        </record>
        <record id="shipment_tracking_activity_action" model="ir.actions.act_window">
            <field name="name">Shipment Tracking Activities</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">shipment.location.activity</field>
            <field name="view_mode">list</field>
        </record>

        <!--Freight Tracking Template-->
        <record id="shipment_tracking_template_view_form" model="ir.ui.view">
            <field name="name">shipment.tracking.template.form.view</field>
            <field name="model">tracking.template</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1" string="Name"/>
                            </group>
                        </group>
                        <div class="row">
                            <div class="col-12" style="margin-bottom:10px;">
                                Template
                            </div>
                            <div class="col-12">
                                <field name="template_ids" string="Template Lines">
                                    <list editable="bottom">
                                        <field name="location_id" required="1" options="{'no_create': True}" string="Location"/>
                                        <field name="activity_id" required="1" options="{'no_create': True}" string="Activity"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="shipment_tracking_template_view_tree" model="ir.ui.view">
            <field name="name">shipment.tracking.template.list.view</field>
            <field name="model">tracking.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" string="Name"/>
                </list>
            </field>
        </record>
        <record id="shipment_tracking_template_action" model="ir.actions.act_window">
            <field name="name">Tracking Templates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">tracking.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="shipment_tracking_template_line_view_form" model="ir.ui.view">
            <field name="name">shipment.tracking.template.line.view.form</field>
            <field name="model">tracking.template.line</field>
            <field name="arch" type="xml">
                <form create="False">
                    <sheet>
                        <group>
                            <group>
                                <field name="location_id" options="{'no_create': True, 'no_open': True}" string="Location"/>
                            </group>
                            <group>
                                <field name="activity_id" options="{'no_create': True, 'no_open': True}" string="Activity"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="shipment_tracking_view_form" model="ir.ui.view">
            <field name="name">shipment.tracking.view.form</field>
            <field name="model">shipment.tracking</field>
            <field name="arch" type="xml">
                <form create="False" edit="0">
                    <header>
                        <field name="status" widget="statusbar" string="Status"/>
                        <button name="action_complete" type="object" string="Complete" class="btn btn-success"
                                invisible="status == 'complete'"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="location_id" options="{'no_create': True, 'no_open': True}" string="Location"/>
                                <field name="activity_id" options="{'no_create': True, 'no_open': True}" string="Activity"/>
                            </group>
                            <group>
                                <field name="date" string="Date"/>
                                <field name="time" widget="float_time" string="Time"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Custom Department -->
        <record id="shipment_custom_department_view_form" model="ir.ui.view">
            <field name="name">shipment.custom.department.view.form</field>
            <field name="model">custom.department</field>
            <field name="arch" type="xml">
                <form create="False" edit="0" delete="0">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="in_process,pass" string="Status"/>
                        <button name="action_pass" type="object" class="btn btn-success" string="Pass"
                                invisible="state == 'pass'"/>
                        <button name="action_in_process" type="object" class="btn btn-info" string="Process"
                                invisible="state in ['in_process', 'pass']"/>
                        <button name="action_cancel" type="object" class="btn btn-danger" string="Cancel"
                                invisible="state in ['pass', 'cancel']"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="declaration" string="Declaration No."/>
                                <field name="note" string="Note"/>
                            </group>
                            <group>
                                <field name="date" string="Date"/>
                                <field name="document" widget="binary" string="Document"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
