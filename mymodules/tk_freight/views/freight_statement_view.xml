<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="freight_statement_search_view" model="ir.ui.view">
            <field name="name">freight.statement.search.view</field>
            <field name="model">freight.statement</field>
            <field name="arch" type="xml">
                <search string="Search Settlement Statements">
                    <field name="name" string="Statement Number"/>
                    <field name="freight_operation_id" string="Freight Operation"/>
                    <field name="customer_id" string="Customer"/>
                    <field name="state" string="Status"/>
                    <filter string="Draft" name="statement_draft"
                            domain="[('state','=','draft')]"/>
                    <filter string="Confirmed" name="statement_confirmed"
                            domain="[('state','=','confirmed')]"/>
                    <filter string="Voided" name="statement_voided"
                            domain="[('state','=','voided')]"/>
                    <filter string="Draft Invoice" name="statement_draft_invoice"
                            domain="[('state','=','draft_invoice')]"/>
                    <group>
                        <filter string="State" name="group_state"
                                context="{'group_by':'state'}"/>
                        <filter string="Customer" name="group_customer"
                                context="{'group_by':'customer_id'}"/>
                        <filter string="Freight Operation" name="group_operation"
                                context="{'group_by':'freight_operation_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="freight_statement_list_view" model="ir.ui.view">
            <field name="name">freight.statement.list.view</field>
            <field name="model">freight.statement</field>
            <field name="arch" type="xml">
                <list string="Settlement Statements">
                    <field name="name" string="Statement Number"/>
                    <field name="freight_operation_id" string="Freight Operation"/>
                    <field name="customer_id" string="Customer"/>
                    <field name="state" string="Status" widget="badge"/>
                    <field name="version_no" string="Version"/>
                    <field name="settlement_date" string="Settlement Date"/>
                    <field name="amount_untaxed" string="Untaxed Amount"/>
                    <field name="tax_amount" string="Tax Amount"/>
                    <field name="amount_total" string="Total Amount"/>
                </list>
            </field>
        </record>

        <record id="freight_statement_form_view" model="ir.ui.view">
            <field name="name">freight.statement.form.view</field>
            <field name="model">freight.statement</field>
            <field name="arch" type="xml">
                <form string="Settlement Statement" create="False">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,draft_invoice"
                               readonly="1"/>
                        <button name="action_confirm" type="object" string="Confirm"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_void" type="object" string="Void"
                                class="btn-danger" invisible="state != 'draft'"/>
                        <button name="action_print_statement" type="object"
                                string="Print Statement" class="btn-secondary"/>
                        <button name="action_generate_draft_invoice" type="object"
                                string="Generate Draft Invoice" class="btn-primary"
                                invisible="state != 'confirmed'"/>
                        <button name="button_open_invoices" type="object" string="Invoices"
                                class="btn-secondary" invisible="invoice_count == 0"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="freight_operation_id" readonly="1"
                                       string="Freight Operation"/>
                                <field name="customer_id" readonly="1" string="Customer"/>
                                <field name="forwarder_contact"
                                       readonly="state != 'draft'"
                                       string="Forwarder Contact"/>
                                <field name="settlement_date" readonly="state != 'draft'"
                                       string="Settlement Date"/>
                            </group>
                            <group>
                                <field name="version_no" readonly="1" string="Version"/>
                                <field name="statement_id" readonly="1"
                                       string="Root Statement"/>
                                <field name="previous_statement_id" readonly="1"
                                       string="Previous Statement"/>
                                <field name="voided_uid" readonly="1"
                                       invisible="not voided_uid" string="Voided By"/>
                                <field name="voided_date" readonly="1"
                                       invisible="not voided_date" string="Voided On"/>
                                <field name="voided_reason" readonly="1"
                                       invisible="not voided_reason" string="Void Reason"/>
                                <field name="confirmed_uid" readonly="1"
                                       invisible="not confirmed_uid" string="Confirmed By"/>
                                <field name="confirmed_date" readonly="1"
                                       invisible="not confirmed_date" string="Confirmed On"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="statement_line_ids" nolabel="1"
                                       create="False" delete="False">
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="service_type" string="Service To"/>
                                        <field name="product_id" string="Product"/>
                                        <field name="name" string="Description"/>
                                        <field name="partner_id" string="Invoice To"/>
                                        <field name="qty" string="Quantity" readonly="1"/>
                                        <field name="price_unit" string="Unit Price"
                                               readonly="1"/>
                                        <field name="currency_id" string="Currency"
                                               readonly="1"/>
                                        <field name="tax_code" string="Tax Code"/>
                                        <field name="tax_name" string="Tax Name"/>
                                        <field name="tax_rate" string="Tax Rate (%)"/>
                                        <field name="tax_amount" string="Tax Amount"/>
                                        <field name="amount_untaxed" string="Untaxed Amount"/>
                                        <field name="amount_total" string="Total Amount"/>
                                        <field name="settlement_rate"
                                               string="Settlement Rate"/>
                                        <field name="amount_total_company"
                                               string="Total (Company)"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Summary">
                                <group>
                                    <field name="currency_summary" string="Currency Summary"/>
                                </group>
                                <group>
                                    <group>
                                        <field name="amount_untaxed"
                                               string="Untaxed Amount (Company)"/>
                                    </group>
                                    <group>
                                        <field name="tax_amount"
                                               string="Tax Amount (Company)"/>
                                    </group>
                                    <group>
                                        <field name="amount_total"
                                               string="Total Amount (Company)"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_freight_statement" model="ir.actions.act_window">
            <field name="name">Settlement Statements</field>
            <field name="res_model">freight.statement</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="freight_statement_search_view"/>
        </record>
    </data>
</odoo>
