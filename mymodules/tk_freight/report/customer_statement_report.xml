<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="customer_statement_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <style>
                            .statement-page {
                                font-size: 13px;
                                color: #000;
                            }
                            .statement-page h2 {
                                text-align: center;
                                font-size: 20px;
                                margin-bottom: 12px;
                            }
                            .statement-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 8px;
                            }
                            .statement-table th,
                            .statement-table td {
                                border: 1px solid #000;
                                padding: 4px 6px;
                                vertical-align: top;
                            }
                            .statement-table th {
                                background: #f2f2f2;
                                text-align: center;
                            }
                            .amount-cell {
                                text-align: right;
                                white-space: nowrap;
                            }
                            .sign-area {
                                margin-top: 48px;
                            }
                        </style>
                        <div class="statement-page">
                            <h2>出口货代费用确认单（应收对账单）</h2>

                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="width:55%;padding:0px;">
                                        <div style="display:flex;align-items:center;">
                                            <t t-if="o.company_id.logo">
                                                <img t-att-src="image_data_uri(o.company_id.logo)"
                                                     alt="Logo"
                                                     style="max-width:90px;max-height:70px;margin-right:8px;"/>
                                            </t>
                                            <div>
                                                <div style="font-weight:bold;font-size:15px;">
                                                    <span t-field="o.company_id.name"/>
                                                </div>
                                                <t t-if="o.company_id.phone">
                                                    <div>联系电话：<span t-field="o.company_id.phone"/></div>
                                                </t>
                                                <t t-if="o.company_id.email">
                                                    <div>邮箱：<span t-field="o.company_id.email"/></div>
                                                </t>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="width:45%;padding:0px;text-align:right;">
                                        <div>单据编号：<span t-field="o.name"/></div>
                                        <div>制单日期：<span t-field="o.settlement_date"/></div>
                                        <div>内部工作号：<span t-field="o.freight_operation_id.name"/></div>
                                    </td>
                                </tr>
                            </table>

                            <table style="width:100%;border-collapse:collapse;margin-top:10px;">
                                <tr>
                                    <td style="width:50%;padding:0px;">
                                        <div><strong>客户（付款方）：</strong><span t-field="o.customer_id.name"/></div>
                                        <t t-if="o.forwarder_contact">
                                            <div>对接货代人员：<span t-field="o.forwarder_contact"/></div>
                                        </t>
                                    </td>
                                    <td style="width:50%;padding:0px;">
                                        <t t-if="o.freight_operation_id.transport == 'ocean'">
                                            <div>船名航次：
                                                <span t-field="o.freight_operation_id.vessel_id.name"/>
                                                <t t-if="o.freight_operation_id.voyage_no">
                                                    / <span t-field="o.freight_operation_id.voyage_no"/>
                                                </t>
                                            </div>
                                            <div>提单号：
                                                <t t-if="o.freight_operation_id.bl_number">
                                                    <span t-field="o.freight_operation_id.bl_number"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-field="o.freight_operation_id.obl"/>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-elif="o.freight_operation_id.transport == 'air'">
                                            <div>航班信息：
                                                <span t-field="o.freight_operation_id.airline_id.name"/>
                                                <t t-if="o.freight_operation_id.flight_no">
                                                    / <span t-field="o.freight_operation_id.flight_no"/>
                                                </t>
                                            </div>
                                            <div>运单号：<span t-field="o.freight_operation_id.mawb_no"/></div>
                                        </t>
                                        <t t-elif="o.freight_operation_id.transport == 'land'">
                                            <div>运输信息：<span t-field="o.freight_operation_id.truck_ref"/></div>
                                            <div>车牌/参考号：<span t-field="o.freight_operation_id.trucker_number"/></div>
                                        </t>
                                        <t t-if="o.freight_operation_id.pickup_datetime">
                                            <div>开航日期：<span t-field="o.freight_operation_id.pickup_datetime"/></div>
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <table class="statement-table">
                                <thead>
                                    <tr>
                                        <th style="width:18%;">关联运输信息</th>
                                        <th style="width:24%;">费用名称</th>
                                        <th style="width:10%;">结算币种</th>
                                        <th style="width:16%;">单价 / 数量</th>
                                        <th style="width:14%;">税率 / 税额</th>
                                        <th style="width:18%;">应收金额(RMB)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.statement_line_ids" t-as="line">
                                        <tr>
                                            <td><span t-field="line.product_id.name"/></td>
                                            <td><span t-field="line.name"/></td>
                                            <td><span t-field="line.currency_id.name"/></td>
                                            <td><span t-field="line.price_unit"/> / <span t-field="line.qty"/></td>
                                            <td>
                                                <t t-if="line.tax_rate">
                                                    <span t-field="line.tax_rate"/>%
                                                </t>
                                                <t t-else="">
                                                    0%
                                                </t>
                                                <span> / </span>
                                                <span t-field="line.tax_amount"/>
                                            </td>
                                            <td class="amount-cell"><span t-field="line.amount_total_company"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>

                            <table style="width:100%;border-collapse:collapse;margin-top:8px;">
                                <tr>
                                    <td style="width:50%;padding:0px;"></td>
                                    <td style="width:50%;padding:0px;">
                                        <table style="width:100%;border-collapse:collapse;">
                                            <tr>
                                                <td style="padding:4px 6px;">不含税合计</td>
                                                <td class="amount-cell" style="padding:4px 6px;">
                                                    <span t-field="o.amount_untaxed"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:4px 6px;">税额合计</td>
                                                <td class="amount-cell" style="padding:4px 6px;">
                                                    <span t-field="o.tax_amount"/>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:4px 6px;font-weight:bold;">总应收金额</td>
                                                <td class="amount-cell" style="padding:4px 6px;font-weight:bold;">
                                                    <span t-field="o.amount_total"/>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <t t-if="o.company_id.bank_ids">
                                <h4 style="margin-top:16px;">对公收款账户信息</h4>
                                <t t-foreach="o.company_id.bank_ids" t-as="bank">
                                    <div>
                                        <span t-esc="bank.currency_id.name or '银行账户'"/>账户：
                                        开户行 <span t-field="bank.bank_id.name"/>，
                                        账号 <span t-field="bank.acc_number"/>
                                        <t t-if="bank.acc_holder_name">
                                            ，户名 <span t-field="bank.acc_holder_name"/>
                                        </t>
                                    </div>
                                </t>
                            </t>

                            <h4 style="margin-top:16px;">业务权责 &amp; 结算条款</h4>
                            <ol style="padding-left:20px;margin:0;">
                                <li>
                                    我司（<span t-field="o.customer_id.name"/>）委托
                                    <span t-field="o.company_id.name"/>出运货物，本票货物已按约定正常出运；
                                    所有代操作服务（代装箱、产装、代理报关、订舱等）客户全部认可。
                                </li>
                                <li>
                                    运费及配套费用付款期限：船舶开航后5个工作日内结清。
                                </li>
                                <li>
                                    未按期足额支付款项，逾期部分按每日千分之三计收违约金。
                                </li>
                                <li>
                                    客户逾期未结清费用，货代有权留置本票对应提单、全套货运单据，直至款项付清。
                                </li>
                                <li>
                                    底部预留客户盖章、填写年月日位置，盖章后具备对账/结算约束效力。
                                </li>
                            </ol>

                            <div class="sign-area">
                                <div>客户盖章：____________________________</div>
                                <div style="margin-top:16px;">日期：____________年______月______日</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="freight_statement_report" model="ir.actions.report">
            <field name="name">Customer Statement Report</field>
            <field name="model">freight.statement</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">tk_freight.customer_statement_report_template</field>
            <field name="report_file">tk_freight.customer_statement_report_template</field>
            <field name="print_report_name">'%s-对账单' % (object.name)</field>
        </record>
    </data>
</odoo>
