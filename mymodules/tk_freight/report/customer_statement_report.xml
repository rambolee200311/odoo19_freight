<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="customer_statement_report_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="tk_freight.custom_external_layout">
                        <div class="page" style="font-family: 'Noto Sans SC', 'WenQuanYi Micro Hei', 'SimSun', serif; font-size: 11px; padding: 15px;">

                            <!-- 公司抬头 -->
                            <div style="text-align:center; margin-bottom:6px;">
                                <div style="font-weight:bold; font-size:14px;">
                                    <h1 style="font-size:24px"><span t-esc="o.company_id.name"/></h1>
                                </div>
                                <div style="font-size:10px; margin-top:2px;">
                                    TEL:<span t-esc="o.company_id.phone or ''"/>
                                    <t t-if="o.company_id.email">
                                        &#160;E-MAIL:<span t-esc="o.company_id.email"/>
                                    </t>
                                </div>
                            </div>

                            <!-- 标题 -->
                            <h2 style="text-align:center; font-size:20px; font-weight:bold; margin:10px 0; border-bottom:1px solid #000; padding-bottom:4px;">
                                费用确认
                            </h2>

                            <!-- TO / DATE / FM / 工作号 -->
                            <div style="margin-bottom:8px; font-size:12px;">
                                <div style="margin-bottom:2px;">
                                    <strong>TO:</strong><span t-esc="o.customer_id.name or ''"/>
                                    <span style="float:right;"><strong>DATE:</strong> <span t-esc="o.settlement_date or ''"/></span>
                                </div>
                                <div style="margin-bottom:2px;">
                                    <strong>联系人:</strong><span t-esc="o.customer_id.name or ''"/>
                                    <span style="float:right;"><strong>TEL:</strong> <span t-esc="o.customer_id.phone or ''"/></span>
                                </div>
                                <div>
                                    <strong>FM:</strong><span t-esc="o.company_id.name or ''"/> <span t-esc="o.create_uid.name or ''"/>
                                    <span style="float:right;"><strong>工作号:</strong> <span t-esc="o.freight_operation_id.name or ''"/></span>
                                </div>
                            </div>

                            <!-- 5列费用表格 -->
                            <table rules="none" style="width:100%; border-collapse:collapse; margin-top:6px; font-size:12px; border:1px solid #000 !important;">
                                <thead>
                                    <tr style="border:0 !important;">
                                        <th style="padding:3px 6px; border-bottom:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-top:0 !important; text-align:left;">货物描述</th>
                                        <th style="padding:3px 6px; border-bottom:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-top:0 !important; text-align:left;">费用名称</th>
                                        <th style="padding:3px 6px; border-bottom:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-top:0 !important; text-align:left;">币种</th>
                                        <th style="padding:3px 6px; border-bottom:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-top:0 !important; text-align:left;">单价/数量</th>
                                        <th style="padding:3px 6px; border-bottom:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-top:0 !important; text-align:right;">金额</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- 第一行：货物描述 + 第一条费用 -->
                                    <tr style="border:0 !important;">
                                        <td t-att-rowspan="len(o.statement_line_ids)" style="padding:3px 6px; border:0 !important;">
                                            <t t-if="o.freight_operation_id.transport == 'ocean'">
                                                船名:<span t-esc="o.freight_operation_id.vessel_id.name or ''"/><br/>
                                                提单号:<span t-esc="o.freight_operation_id.bl_number or o.freight_operation_id.obl or ''"/>
                                            </t>
                                        </td>
                                        <t t-if="o.statement_line_ids">
                                            <td style="padding:3px 6px; border:0 !important;"><span t-esc="o.statement_line_ids[0].name"/></td>
                                            <td style="padding:3px 6px; border:0 !important;"><span t-esc="o.statement_line_ids[0].currency_id.name"/></td>
                                            <td style="padding:3px 6px; border:0 !important; text-align:right;"><span t-esc="o.statement_line_ids[0].price_unit"/>/<span t-esc="o.statement_line_ids[0].qty"/></td>
                                            <td style="padding:3px 6px; border:0 !important; text-align:right;"><span t-esc="o.statement_line_ids[0].amount_total_company"/></td>
                                        </t>
                                    </tr>
                                    <!-- 后续行：只输出费用列 -->
                                    <t t-foreach="o.statement_line_ids[1:]" t-as="line">
                                        <tr style="border:0 !important;">
                                            <td style="padding:3px 6px; border:0 !important;"><span t-esc="line.name"/></td>
                                            <td style="padding:3px 6px; border:0 !important;"><span t-esc="line.currency_id.name"/></td>
                                            <td style="padding:3px 6px; border:0 !important; text-align:right;"><span t-esc="line.price_unit"/>/<span t-esc="line.qty"/></td>
                                            <td style="padding:3px 6px; border:0 !important; text-align:right;"><span t-esc="line.amount_total_company"/></td>
                                        </tr>
                                    </t>
                                    <!-- 合计行 -->
                                    <tr style="border:0 !important;">
                                        <td colspan="4" style="padding:3px 6px; border-top:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-bottom:0 !important; text-align:right; font-weight:bold;">
                                            费用合计:<span t-esc="o.currency_id.name or 'RMB'"/>合计:
                                        </td>
                                        <td style="padding:3px 6px; border-top:1px solid #000 !important; border-left:0 !important; border-right:0 !important; border-bottom:0 !important; text-align:right; font-weight:bold;">
                                            <span t-esc="o.amount_total"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- 条款 -->
                            <div style="margin-top:10px; font-size:10px; line-height:1.5;">
                                <p style="margin:2px 0;">我司委托贵司出运的货物已于以下列明的信息正常出运，我司保证根据本确认书的有关规定支付运费及其他相关费用。我司同意,在未按本确认书履行支付相关费用的情况下,我司同意贵司留置本票货物的提单及其他相关运输单据。</p>
                                <p style="margin:2px 0;">收付期限:船开五个工作日之内 (如未能按期支付,应按未能支付数额的部分按日支付千分之3的违约金)</p>
                                <p style="margin:2px 0;">我司同时确认，贵司在根据我司订舱进行操作时，根据我司指示委托为出运或采取的包括但不限于代为装箱，指派车队产装，代为报关等我司均予以确认。</p>
                            </div>

                            <!-- 盖章区 -->
                            <div style="margin-top:30px; font-size:11px;">
                                <div>贵公司盖章处</div>
                                <div style="margin-top:15px;">年 月 日</div>
                            </div>

                        </div>
                    </t>
                </t>
            </t>
        </template>

        <record id="freight_statement_report" model="ir.actions.report">
            <field name="name">Customer Statement Report</field>
            <field name="model">freight.statement</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">tk_freight.customer_statement_report_template</field>
            <field name="report_file">tk_freight.customer_statement_report_template</field>
            <field name="print_report_name">'%s-对账单' % (object.name)</field>
        </record>
    </data>
</odoo>
