<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="land_waybill_qweb_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-if="o.transport=='land'">
                    <t t-call="web.internal_layout">
                        <div class="page">
                            <h2 class="text-primary">
                                E-Way Bill
                            </h2>
                            <h5 class="mb-1 text-primary"> 1. E-Way Bill Details
                            </h5>
                            <table class="table table-sm">
                                <tr>
                                    <td style="width:33.33%;">B/L : <strong>
                                            <span t-field="o.bl_number" />
                                        </strong>
                                    </td>
                                    <td style="width:33.33%;"> Issue Date : <strong>
                                            <span t-field="o.si_issue_date" />
                                        </strong></td>
                                    <td style="width:33.33%;"> Generated By : <strong>
                                            <span t-field="o.operator_id" />
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:33.33%;">Mode : <strong>
                                            <span t-field="o.transport" />
                                        </strong>
                                    </td>
                                    <td style="width:33.33%;"> Approx Distance : <strong>
                                            <span t-field="o.distance" /> KM </strong></td>
                                    <td style="width:33.33%;"> Type : <strong>
                                            <span t-field="o.move_type" />
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:33.33%;">Incoterms : <strong>
                                            <span t-field="o.incoterm" />
                                        </strong>
                                    </td>
                                    <td style="width:33.33%;"> No Bill: <strong>
                                            <span t-field="o.no_bill" />
                                        </strong></td>
                                    <td style="width:33.33%;"> Valid Upto : <strong>
                                            <span t-field="o.valid_date" /> KM </strong>
                                    </td>
                                </tr>
                            </table>
                            <h5 class="mb-1 text-primary"> 2. Address Details
                            </h5>
                            <table class="table table-sm">
                                <tr>
                                    <td style="width:50%;">
                                        <strong>Shipper : </strong> <span t-field="o.shipper_id" />
                                        <br />
                                        <t
                                            t-if="o.shipper_id.vat"> TAX ID : <span
                                                t-field="o.shipper_id.vat" />
                                                 <br />
                                        </t>

                                            <strong>
                                        Tel. : </strong>
                                            <span>
                                            <span t-field="o.shipper_id.phone" />
                                        </span>
                                            <br />
                                            <strong>Email
                                        : </strong>
                                            <span>
                                            <span t-field="o.shipper_id.email" />
                                        </span>
                                        <br />
                                        From :<strong>
                                            <t
                                                t-if="o.address_to=='location_address'">
                                                <strong>
                                                    <span t-field="o.source_location_id" />
                                                </strong>
                                            </t>
                                            <t t-else="">
                                                Shipper Address</t>
                                        </strong>
                                        <br />
                                        <span>
                                            <span t-field="o.s_street" />
                                            <br />
                                            <t t-if="o.s_street2">

                                                <span t-field="o.s_street2" />, <br />
                                            </t>
                                            <span
                                                t-field="o.s_city" />
                                            <span t-field="o.s_zip" />
                                            <br />
                                            <span
                                                t-field="o.s_state_id" />
                                            <span
                                                t-field="o.s_country_id.name" />
                                        </span>
                                    </td>
                                    <td style="width:50%;">
                                        <strong>Consignee : </strong> <span t-field="o.consignee_id" />
                                        <br />
                                        <t
                                            t-if="o.consignee_id.vat"> TAX ID : <span
                                                t-field="o.consignee_id.vat" />
                                                 <br />
                                        </t>

                                            <strong>
                                        Tel. : </strong>
                                            <span>
                                            <span t-field="o.consignee_id.phone" />
                                        </span>
                                            <br />
                                            <strong>Email
                                        : </strong>
                                            <span>
                                            <span t-field="o.consignee_id.email" />
                                        </span>
                                        <br />
                                        To : <strong>
                                            <t
                                                t-if="o.address_to=='location_address'">
                                                <strong>
                                                    <span t-field="o.destination_location_id" />
                                                </strong>
                                            </t>
                                            <t t-else="">
                                                Consignee Address</t>
                                        </strong>
                                        <br />
                                        <span>
                                            <span t-field="o.d_street" />
                                            <br />
                                            <t t-if="o.d_street2">
                                                <span t-field="o.d_street2" />, <br />
                                            </t>
                                            <span
                                                t-field="o.d_city" />
                                            <span t-field="o.d_zip" />
                                            <br />
                                            <span
                                                t-field="o.d_state_id" />
                                            <span
                                                t-field="o.d_country_id.name" />
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <h5 class="mb-1 text-primary"> 3. Goods Details
                            </h5>
                            <table class="table table-sm">

                                <tr>
                                    <td>
                                        <strong>
                                            No
                                        </strong>
                                    </td>
                                    <td>
                                        <strong>
                                            Goods
                                        </strong>
                                    </td>
                                    <td>
                                        <strong>
                                            Type
                                        </strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <strong>
                                            Qty
                                        </strong>
                                    </td>
                                    <td style="text-align:right;">
                                        <strong>
                                            Price
                                        </strong>
                                    </td>
                                </tr>
                                <tr t-foreach="o.freight_packages" t-as="s">
                                    <td>
                                        <span t-field="s.seal_number" />
                                    </td>
                                    <td>
                                        <span t-field="s.package" />
                                    </td>
                                    <td>
                                        <span t-field="s.container_type" />
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="s.qty" />
                                    </td>
                                    <td style="text-align:right;">
                                        <span t-field="s.charges" />
                                    </td>
                                </tr>
                            </table>
                            <h5 class="mb-1 text-primary"> 4. Transportation &amp;
                                Vehicle Details
                            </h5>
                            <table class="table table-sm">

                                <tr>
                                    <td style="width:33.33%;">RWB : <strong>
                                            <span t-field="o.truck_ref" />
                                        </strong>
                                    </td>
                                    <td style="width:33.33%;"> Vehicle : <strong>
                                            <span t-field="o.trucker" />
                                        </strong></td>
                                    <td style="width:33.33%;"> Owner : <strong>
                                            <span t-field="o.truck_owner_id" />
                                        </strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:33.33%;">Truck Ref : <strong>
                                            <span t-field="o.trucker_number" />
                                        </strong>
                                    </td>
                                    <td style="width:33.33%;"> Payable At : <strong>
                                            <span t-field="o.freight_payable" />
                                        </strong></td>
                                    <td style="width:33.33%;"> Tracking : <strong>
                                            <span t-field="o.tracking_number" />
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                            <div class="text-center mt-3">
                                <t t-if="o.barcode">
                                    <img
                                        t-attf-src="/report/barcode/?barcode_type=Code128&amp;value={{o.barcode}}&amp;width=168&amp;height=100&amp;humanreadable=1&amp;quiet=0"
                                        width="180" height="90"
                                        alt="QR Code" />
                                </t>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </t>
    </template>
    <record id="waybill_land_qweb_shipment_action" model="ir.actions.report">
        <field name="name">Waybill - Land</field>
        <field name="model">freight.shipment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tk_freight.land_waybill_qweb_report_template</field>
        <field name="report_file">tk_freight.land_waybill_qweb_report_template</field>
    </record>
</odoo>