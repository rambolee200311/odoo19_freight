#. module: tk_freight
#: model:mail.template,body_html:tk_freight.quot_sent_mail_template
msgid ""
"<span>\n"
"                    <p>\n"
"                        Dear\n"
"                        <br/>\n"
"                        <strong>\n"
"                            <span t-field=\"object.consignee_id.name\"/>\n"
"                        </strong>\n"
"                        </p><hr class=\"mb-1 mt-1\"/>\n"
"                        Thank you for your interest in our freight shipment services. We appreciate the opportunity to\n"
"                        provide\n"
"                        you with a quotation based on your inquiry.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        <strong>\n"
"                            Please find attachment for quotation details\n"
"                        </strong>\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Please note that the above quotation is an estimate and subject to change based on any\n"
"                        additional\n"
"                        services required or changes in the shipment details. Our aim is to provide you with the most\n"
"                        accurate\n"
"                        pricing possible\n"
"                        <br/>\n"
"                        <br/>\n"
"                        If you have any specific requirements or would like to discuss the quotation further, please\n"
"                        feel\n"
"                        free\n"
"                        to contact us.\n"
"                        <br/>\n"
"                        <br/>\n"
"                        Thank you for considering.\n"
"                        <strong>\n"
"                            <span t-field=\"object.company_id.name\"/>\n"
"                        </strong>\n"
"                    \n"
"                    <br/>\n"
"                    <br/>\n"
