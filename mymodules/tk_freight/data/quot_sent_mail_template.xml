<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="quot_sent_mail_template" model="mail.template">
            <field name="name">Quotation Sent Mail Template</field>
            <field name="model_id" ref="tk_freight.model_shipment_quotation"/>
            <field name="subject">Quotation Details for Your Shipment Inquiry</field>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="partner_to">{{ object.consignee_id.id }}</field>
            <field name="body_html" type="html">
                <span>
                    <p>
                        Dear
                        <br/>
                        <strong>
                            <span t-field="object.consignee_id.name"/>
                        </strong>
                        <hr class="mb-1 mt-1"/>
                        Thank you for your interest in our freight shipment services. We appreciate the opportunity to
                        provide
                        you with a quotation based on your inquiry.
                        <br/>
                        <br/>
                        <strong>
                            Please find attachment for quotation details
                        </strong>
                        <br/>
                        <br/>
                        Please note that the above quotation is an estimate and subject to change based on any
                        additional
                        services required or changes in the shipment details. Our aim is to provide you with the most
                        accurate
                        pricing possible
                        <br/>
                        <br/>
                        If you have any specific requirements or would like to discuss the quotation further, please
                        feel
                        free
                        to contact us.
                        <br/>
                        <br/>
                        Thank you for considering.
                        <strong>
                            <span t-field="object.company_id.name"/>
                        </strong>
                    </p>
                    <br/>
                    <br/>
                    Best regards
                    <br/>
                    <strong>
                        <t t-out="object.company_id.name"/>
                    </strong>
                    <hr/>
                    <span>
                        <t t-out="object.company_id.name"/>
                        <t t-out="object.company_id.phone"/>
                        <br/>
                        <t t-out="object.company_id.email"/>
                        <br/>
                        <t t-out="object.company_id.website"/>
                    </span>
                </span>
            </field>
            <field name="report_template_ids" eval="[(4, ref('tk_freight.freight_quot_report_id'))]"/>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>