<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_update_rates_wizard_form" model="ir.ui.view">
        <field name="name">update.rates.wizard.form</field>
        <field name="model">update.rates.wizard</field>
        <field name="arch" type="xml">
            <form string="更新汇率">
                <group>
                    <field name="provider_id"/>
                    <field name="test_mode"/>
                </group>
                <group>
                    <field name="result" widget="textarea" placeholder="点击执行后查看结果"/>
                </group>
                <footer>
                    <button name="action_update" string="执行" type="object" class="btn-primary"/>
                    <button string="关闭" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_update_rates_wizard" model="ir.actions.act_window">
        <field name="name">更新汇率</field>
        <field name="res_model">update.rates.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 在 Providers 菜单旁加按钮 -->
    <record id="provider_form_view_tk_button" model="ir.ui.view">
        <field name="name">currency.rate.provider.form.tk.button</field>
        <field name="model">currency.rate.provider</field>
        <field name="inherit_id" ref="currency_rate_update.currency_rate_provider_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_update_rates_wizard)d"
                        string="立即更新"
                        type="action"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>
</odoo>
